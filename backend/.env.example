PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/routecraft?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Geoapify API Key (for backend geocoding & routing)
GEOAPIFY_API_KEY=YOUR_KEY

# Optional: Live Airline Flight Booking API Key (Amadeus / Flight API)
# AMADEUS_API_KEY=your_amadeus_api_key
# AMADEUS_API_SECRET=your_amadeus_secret

# Optional: Live Railway Timetable & PNR API Key
# RAIL_API_KEY=your_rail_api_key

